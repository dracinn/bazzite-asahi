# Apple Silicon bootstrap image for Bazzite Asahi.
#
# Start from the existing Fedora Asahi Atomic image instead of rebuilding
# the Asahi kernel/boot/userspace stack inside a generic Fedora Atomic image.
# This keeps the device enablement aligned with Fedora Asahi Remix.

ARG FEDORA_VERSION=44
ARG BASE_IMAGE=quay.io/fedora-asahi-remix-atomic-desktops/kinoite:${FEDORA_VERSION}

FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.title="Bazzite Asahi"
LABEL org.opencontainers.image.description="Bazzite-oriented Fedora Atomic image for Apple Silicon Macs"
LABEL org.opencontainers.image.vendor="Bazzite Asahi"

COPY config/ /etc/bazzite-asahi/

# The base image already contains the Apple Silicon kernel, boot, firmware,
# Mesa and platform integration. Only add ARM64-safe desktop/gaming building
# blocks here; do not pull Bazzite's x86_64/i686 kernel or multilib stack.
#
# Keep this deliberately small until the first bootable image is proven.
RUN dnf5 -y install \
        gamemode \
        zstd \
    && dnf5 clean all

# Steam/Gamescope/Proton/FEX will be added in a separate ARM64 compatibility
# layer once the J313 boot and graphics baseline is validated.
