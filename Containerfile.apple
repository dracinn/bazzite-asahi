# Bootstrap Apple Silicon image.
# Keep this minimal until ARM64 package availability is verified.

ARG FEDORA_VERSION=44
ARG BASE_IMAGE=quay.io/fedora-atomic-desktops/kinoite:${FEDORA_VERSION}

FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.title="Bazzite Asahi"
LABEL org.opencontainers.image.description="Bazzite-oriented Fedora Atomic image for Apple Silicon Macs"
LABEL org.opencontainers.image.vendor="Bazzite Asahi"

COPY config/ /etc/bazzite-asahi/

# Package list is provisional and will be validated against the current
# Fedora/Asahi ARM64 repositories before this becomes a release image.
RUN dnf5 -y install \
        m1n1 \
        alsa-ucm-asahi \
        asahi-platform-metapackage \
        asahi-repos \
        fedora-asahi-remix-scripts \
        tiny-dfr \
        uboot-images-armv8 \
        kernel-16k \
        kernel-16k-modules-extra \
        asahi-fwextract \
        dracut-asahi \
        update-m1n1 \
        asahi-audio \
        speakersafetyd \
        wireplumber \
        pipewire \
        mesa \
    && dnf5 clean all

# Gaming packages will be added only after ARM64 availability is verified.
