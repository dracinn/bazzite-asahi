[Unit]
Description=Sync m1n1/boot.bin on the ESP from the current deployment
# The script locates and mounts the ESP itself (bootc writes no fstab);
# it self-gates and exits quietly on non-Asahi systems.
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/m1n1-bootbin-sync

[Install]
WantedBy=multi-user.target
